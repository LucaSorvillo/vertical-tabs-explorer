#pragma code_page(65001)
#include <winres.h>

// Icona dell'eseguibile: quella della tray su un quadrato scuro (tools\Make-Icon.ps1)
1 ICON "VTabsExplorer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,1,0
 PRODUCTVERSION 1,5,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004b0"
        BEGIN
            VALUE "FileDescription", "Vertical Tabs for File Explorer - schede verticali e sessioni per Esplora file"
            VALUE "FileVersion", "1.5.1.0"
            VALUE "InternalName", "VTabsExplorer"
            VALUE "OriginalFilename", "VTabsExplorer.exe"
            VALUE "ProductName", "Vertical Tabs for File Explorer"
            VALUE "ProductVersion", "1.5.1.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 LucaSorvillo - MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x410, 1200
    END
END
